+// ---------------------------------------------------------------------------
+// [Android W^X] host-side mprotect() wrapper.
+//
+// Android 10+ (targetSdkVersion >= 29) runs apps in the untrusted_app SELinux
+// domain and refuses mprotect(PROT_EXEC) on app-private-storage backed memory.
+// box64 never executes guest pages natively (everything goes through the JIT
+// code cache, which lives in MAP_ANONYMOUS memory), so PROT_EXEC can be
+// stripped from the *host* protection without changing guest semantics.
+//
+// my_mprotect() in wrappedlibc.c strips it for the guest-visible path, but the
+// dynarec/SMC machinery in this file calls host mprotect() directly (protectDB,
+// liftWriteProtection, refreshProtection, updateProtection). Those calls used to
+// keep PROT_EXEC and therefore failed under Android, which in turn made
+// protectors such as WinLicense/SecureEngine impossible to run: they map code
+// RW, decrypt, then mprotect(R-X). Route every host call through
+// box64_host_mprotect() so the W^X workaround covers the whole allocator.
+//
+// Disable with BOX64_ANDROID_WX=0.
+static int box64_android_wx_enabled(void)
+{
+    static int cached = -1;
+    if (cached < 0) {
+        const char* e = getenv("BOX64_ANDROID_WX");
+        cached = (!e || (e[0] != '0' && e[0] != 'n' && e[0] != 'N' && e[0] != 'f' && e[0] != 'F')) ? 1 : 0;
+    }
+    return cached;
+}
+
+#if defined(ANDROID) || defined(TERMUX) || defined(WINLATOR_GLIBC)
+#define BOX64_HOST_WX_STRIP 1
+#else
+#define BOX64_HOST_WX_STRIP 0
+#endif
+
+int box64_host_mprotect(void* addr, size_t len, int prot)
+{
+#if BOX64_HOST_WX_STRIP
+    if (prot & PROT_EXEC) {
+        if (box64_android_wx_enabled())
+            prot &= ~PROT_EXEC;
+        if (!(prot & (PROT_READ | PROT_WRITE)))
+            prot |= PROT_READ;   // never leave a mapping completely inaccessible
+    }
+#else
+    (void)box64_android_wx_enabled;
+#endif
+    return mprotect(addr, len, prot);
+}
