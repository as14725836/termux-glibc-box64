+#if defined(ANDROID) || defined(TERMUX) || defined(WINLATOR_GLIBC)
+/* [Android W^X workaround]
+ *
+ * Android 10+ (targetSdkVersion >= 29) runs apps in the untrusted_app SELinux
+ * domain, which refuses mprotect(PROT_EXEC) on app-private-storage-backed
+ * memory. Guest mprotect() calls then fail, breaking loaders and protectors
+ * that mark code pages executable.
+ *
+ * box64 never executes guest pages natively: every guest instruction is JIT'ed
+ * into box64's own code cache, which is allocated with MAP_ANONYMOUS and is
+ * therefore still allowed to be executable. Stripping PROT_EXEC from the *host*
+ * mapping of guest memory is thus safe.
+ *
+ * Only the flags handed to the host mprotect() are stripped. box64's own
+ * bookkeeping (updateProtection / setGuestProtection) still receives the
+ * original flags, so guest-visible page attributes and the SMC / write
+ * protection state machine are unaffected.
+ *
+ * Set BOX64_ANDROID_WX=0 to get the upstream behaviour back.
+ */
+static int box64_android_wx_strip(void)
+{
+    static int cached = -1;
+    if(cached < 0) {
+        const char* e = getenv("BOX64_ANDROID_WX");
+        cached = (!e || (e[0] != '0' && e[0] != 'n' && e[0] != 'N' && e[0] != 'f' && e[0] != 'F')) ? 1 : 0;
+    }
+    return cached;
+}
+#define BOX64_HOST_MPROT(p) (box64_android_wx_strip() ? ((p) & ~PROT_EXEC) : (p))
+#else
+#define BOX64_HOST_MPROT(p) (p)
+#endif
+
