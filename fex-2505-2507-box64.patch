+/* ===========================================================================
+ * [FEX 2505/2507 compatibility port] JIT invalidation on native file reads
+ * ===========================================================================
+ *
+ * FEX notifies its JIT when a file read lands in executable memory, through
+ * BTCpuNotifyReadFile().  The FEX-2505/2507 implementation is:
+ *
+ *     void BTCpuNotifyReadFile(HANDLE h, void* addr, SIZE_T size,
+ *                              BOOL after, NTSTATUS status)
+ *     {
+ *         if (after && status == STATUS_SUCCESS)
+ *             InvalidationTracker->InvalidateAlignedInterval(addr, size, false);
+ *     }
+ *
+ * Wine calls it around every NtReadFile (dlls/wow64/file.c):
+ *
+ *     if (pBTCpuNotifyReadFile) pBTCpuNotifyReadFile(handle,buffer,len,FALSE,0);
+ *     status = NtReadFile(...);
+ *     if (pBTCpuNotifyReadFile) pBTCpuNotifyReadFile(handle,buffer,len,TRUE,status);
+ *
+ * Why exporting BTCpuNotifyReadFile is not enough here
+ * ---------------------------------------------------
+ * This build runs 64-bit Wine (`box64 wine64 ...`), which never loads
+ * wowbox64.dll.  There is no CPU-DLL layer, so the BTCpu* contract is never
+ * exercised and the export would be dead code.
+ *
+ * box64's only SMC detection is fault based: signals.c traps a write to a
+ * write-protected code page, then unprotectDB(mark=1) ->
+ * cleanDBFromAddressRange() dirties the affected dynablocks.  That covers
+ * writes issued by guest instructions, but a write issued by *native* code -
+ * Wine's unix side - never faults and stays invisible.
+ *
+ * Packed/protected executables exploit exactly that:
+ *
+ *     buf = VirtualAlloc(size, PAGE_EXECUTE_READWRITE);
+ *     read(fd, buf, size);        // native write: no SIGSEGV is generated
+ *     jump into buf;              // box64 still holds dynablocks translated
+ *                                 // from the *encrypted* bytes -> stale code
+ *
+ * What this hook does
+ * -------------------
+ * Intercept the data-ingest syscalls on the syscall path (the only place where
+ * box64 sees a Wine process issue a real kernel read) and invalidate the
+ * destination afterwards - the equivalent of FEX's After=TRUE branch.
+ *
+ * Covered: read(0), pread64(17), readv(19), recvfrom(45), recvmsg(47).
+ * These are the paths a packer or a loader realistically uses to drop code into
+ * a buffer.  Not covered: mmap (box64 already routes it through its own
+ * mapping code and knows about every page it maps), and the *at()/mmsg
+ * variants, which no packer has been observed to use.
+ *
+ * Only the After=TRUE half is ported.  FEX-2508 added an After=FALSE half that
+ * holds a global mutex across the whole syscall; that is a known deadlock
+ * source (fixed upstream in 2509 by 6f5d4fbf / 4df17abe) and is deliberately
+ * NOT reproduced here.  This implements 2505/2507 behaviour.
+ *
+ * Toggle: BOX64_FEX_READFILE_NOTIFY=0 restores upstream behaviour.
+ * Log:    BOX64_SHOWSEGV=1 prints every invalidation.
+ */
+static int box64_fex_readfile_notify(void)
+{
+    static int cached = -1;
+    if (cached < 0) {
+        const char* e = getenv("BOX64_FEX_READFILE_NOTIFY");
+        cached = (!e || (e[0] != '0' && e[0] != 'n' && e[0] != 'N'
+                         && e[0] != 'f' && e[0] != 'F')) ? 1 : 0;
+    }
+    return cached;
+}
+
+/* Syscall numbers are the x86_64 ones, i.e. the guest's view. */
+static int box64_fex_read_syscall(uint32_t s)
+{
+    return (s ==   0)    /* read     */
+        || (s ==  17)    /* pread64  */
+        || (s ==  19)    /* readv    */
+        || (s ==  45)    /* recvfrom */
+        || (s ==  47);   /* recvmsg  */
+}
+
+#ifdef DYNAREC
+/* Only ranges that can hold code are worth touching.  A read into ordinary
+ * anonymous RW memory cannot leave a stale dynablock behind, and skipping it
+ * keeps the common case (every normal file load) free of overhead.
+ *
+ * Note this is a *fast path filter*, not a correctness gate: a page that is
+ * not currently executable cannot have been translated either, so nothing can
+ * be stale in it.  Code that first reads into RW memory and then flips the
+ * page to RX is handled by box64's own mprotect wrapper (updateProtection()),
+ * which cleans the range when PROT_EXEC changes. */
+static int box64_fex_range_is_exec(uintptr_t addr, size_t size)
+{
+    if (!addr || !size || !box64_pagesize) return 0;
+    uintptr_t end  = addr + size;
+    uintptr_t page = (uintptr_t)box64_pagesize;
+    for (uintptr_t p = addr & ~(page - 1); p < end; p += page) {
+        if (getProtection(p) & PROT_EXEC) return 1;
+    }
+    return 0;
+}
+
+#define BOX64_FEX_INVALIDATE(ptr, len)                                        \
+    do {                                                                      \
+        if (box64_fex_range_is_exec((uintptr_t)(ptr), (len))) {               \
+            unprotectDB((uintptr_t)(ptr), (size_t)(len), 1);                  \
+            if (BOX64ENV(showsegv))                                           \
+                printf_log(LOG_INFO,                                          \
+                    "[FEX port] read %p-%p <- %zu bytes, dynablocks invalidated\n", \
+                    (void*)(ptr), (void*)((uintptr_t)(ptr) + (len)),          \
+                    (size_t)(len));                                           \
+        }                                                                     \
+    } while (0)
+#endif
+
+/* Called from the read wrappers in x64Syscall_linux() right after the real
+ * syscall returns.  `ret` is the raw kernel return value (bytes read, or a
+ * negative errno). */
+void box64_fex_notify_readfile(uint32_t s, uintptr_t buf, size_t len,
+                               ssize_t ret)
+{
+#ifdef DYNAREC
+    if (!box64_fex_readfile_notify()) return;
+    if (!box64_wine)                  return;  /* only meaningful under Wine */
+    if (!box64_fex_read_syscall(s))   return;
+    if (ret <= 0)                     return;  /* FEX: only on success       */
+
+    /* FEX invalidates `Size`, but a short read wrote only `ret` bytes.  Using
+     * ret is strictly safer: it never dirties a range that was not touched. */
+    size_t n = (size_t)ret;
+    if (len && n > len) n = len;
+    if (!n) return;
+
+    /* mark=1 -> cleanDBFromAddressRange(): mark every dynablock overlapping
+     * the range as dirty so it is re-translated on next entry.  box64's
+     * equivalent of InvalidateAlignedInterval(), and the same call box64's
+     * own wowbox64.c makes from BTCpuNotifyMemoryDirty(). */
+    BOX64_FEX_INVALIDATE(buf, n);
+#else
+    (void)s; (void)buf; (void)len; (void)ret;
+#endif
+}
+
+#ifdef DYNAREC
+/* readv(19): walk the iovec array and invalidate every executable
+ * destination.  Kept separate from the plain read path because a readv can
+ * scatter into several buffers. */
+void box64_fex_notify_readv(void* iov, size_t iovcnt, ssize_t ret)
+{
+    if (!box64_fex_readfile_notify()) return;
+    if (!box64_wine)                  return;
+    if (ret <= 0)                     return;
+    if (!iov || !iovcnt || iovcnt > 1024) return;
+    /* struct iovec { void* iov_base; size_t iov_len; } - identical layout on
+     * x86_64 and aarch64, so the guest array can be read directly. */
+    struct fex_iovec_s { void* base; size_t len; }* v = (void*)iov;
+    size_t left = (size_t)ret;
+    for (size_t i = 0; i < iovcnt && left; ++i) {
+        size_t n = v[i].len;
+        if (n > left) n = left;
+        if (n) BOX64_FEX_INVALIDATE(v[i].base, n);
+        left -= n;
+    }
+}
+
+/* recvmsg(47): the received payload goes into msg_iov, a plain iovec array
+ * referenced by the msghdr.  On x86_64 msghdr is:
+ *   void* msg_name; socklen_t msg_namelen; struct iovec* msg_iov;
+ *   size_t msg_iovlen; void* msg_control; size_t msg_controllen; int msg_flags;
+ * so msg_iov sits at offset 16 and msg_iovlen at offset 24 (both 8-byte on
+ * x86_64).  Only min(ret, total) bytes were written, in iovec order. */
+void box64_fex_notify_recvmsg(void* msg, ssize_t ret)
+{
+    if (!box64_fex_readfile_notify()) return;
+    if (!box64_wine)                  return;
+    if (ret <= 0 || !msg)             return;
+    void**  m      = (void**)msg;
+    void*   iov    = m[2];              /* msg_iov    */
+    size_t  iovcnt = (size_t)m[3];      /* msg_iovlen */
+    if (!iov || !iovcnt || iovcnt > 1024) return;
+    struct fex_iovec_s { void* base; size_t len; }* v = (void*)iov;
+    size_t left = (size_t)ret;
+    for (size_t i = 0; i < iovcnt && left; ++i) {
+        size_t n = v[i].len;
+        if (n > left) n = left;
+        if (n) BOX64_FEX_INVALIDATE(v[i].base, n);
+        left -= n;
+    }
+}
+#else  /* !DYNAREC */
+/* The call sites in x64Syscall_linux() are unconditional; without the
+ * dynarec there is nothing to invalidate, so provide no-op stubs to keep
+ * the build warning-free. */
+void box64_fex_notify_readv(void* iov, size_t iovcnt, ssize_t ret)
+{ (void)iov; (void)iovcnt; (void)ret; }
+void box64_fex_notify_recvmsg(void* msg, ssize_t ret)
+{ (void)msg; (void)ret; }
+#endif
