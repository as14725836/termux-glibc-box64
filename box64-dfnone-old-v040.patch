# box64 v0.4.0 专用：把 ARM64 dynarec 的 df-none 改回“立即写盘”（旧版语义）
# 适用：上游 tag v0.4.0（2026-01-03）的干净源码树
# 用法：cd box64 && patch -p1 -F0 -i box64-dfnone-old-v040.patch
# 说明：编译期修改，不新增任何环境变量。改写4 处：
#   1) helper.h   SET_DFNONE() 立即 FORCE_DFNONE() 并置 status_none
#   2) pass0.h    分析阶段不再产生 status_none_pending
#   3) pass1.h    同上
#   4) helper.c    块间过渡：目标块已知 df=none 时直接写回 df=0
diff --git a/src/dynarec/arm64/dynarec_arm64_helper.h b/src/dynarec/arm64/dynarec_arm64_helper.h
--- a/src/dynarec/arm64/dynarec_arm64_helper.h
+++ b/src/dynarec/arm64/dynarec_arm64_helper.h
@@ -1003,12 +1003,13 @@
 #define FORCE_DFNONE()  STRw_U12(wZR, xEmu, offsetof(x64emu_t, df))
 #define CHECK_DFNONE(N)  do {if(dyn->f==status_none_pending) {FORCE_DFNONE(); if(N) dyn->f = status_none;}} while(0)
 
-#define SET_DFNONE()                                                    \
-    do {                                                                \
-        if(!dyn->insts[ninst].x64.may_set && (dyn->f!=status_none)) {   \
-            dyn->f = status_none_pending;                               \
-        }                                                               \
-    } while(0)
+#define SET_DFNONE()                      \
+    do {                                  \
+        if (dyn->f != status_none) {      \
+            FORCE_DFNONE();               \
+            dyn->f = status_none;         \
+        }                                 \
+    } while (0)
 
 #define SET_DF(S, N)                                                                                                            \
     if ((N) != d_none) {                                                                                                        \
diff --git a/src/dynarec/arm64/dynarec_arm64_helper.c b/src/dynarec/arm64/dynarec_arm64_helper.c
--- a/src/dynarec/arm64/dynarec_arm64_helper.c
+++ b/src/dynarec/arm64/dynarec_arm64_helper.c
@@ -2301,6 +2301,7 @@
         return;
     if(dyn->insts[jmp].df_notneeded)
         return;
+    if(dyn->insts[jmp].f_entry==status_none && dyn->insts[ninst].f_exit!=status_none && !(dyn->insts[jmp].x64.need_before&X_PEND)) { FORCE_DFNONE(); }
     MESSAGE(LOG_DUMP, "\tFlags fetch ---- ninst=%d -> %d\n", ninst, jmp);
     int go_fetch = 0;
     switch(dyn->insts[jmp].f_entry) {
